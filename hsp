def shift_bits(binary_string, direction, steps):
    print(f"Original Binary: {binary_string}")
    current = binary_string

    for step in range(1, steps + 1):
        if direction == "left":
            current = current[1:] + "0"
        else:
            current = "0" + current[:-1]
            
        print(f"  Step {step}: {current}")
    print()

print("--- a) Logical Left Shift ---")
shift_bits("10110110", "left", 2)

print("--- b) Logical Right Shift ---")
shift_bits("11010100", "right", 2)
